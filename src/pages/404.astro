---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="404 · No encontrado" description="La página solicitada no existe.">
  <section class="grid min-h-[60vh] place-items-center py-16 text-center">
    <div>
      <p class="font-mono text-sm text-fg-subtle">error 404</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-fg">
        <span class="text-accent">$</span> page not found
      </h1>
      <p class="mt-3 text-fg-muted">La ruta solicitada no existe en este blog.</p>
      <a href="/" class="link mt-6 inline-block">Volver al inicio →</a>
    </div>
  </section>
</BaseLayout>
