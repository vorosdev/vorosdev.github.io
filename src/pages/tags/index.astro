---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { slugify } from '~/lib/slug';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const tagMap = new Map<string, number>();
for (const p of posts) {
  for (const tag of p.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagMap.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name, count]) => ({ name, slug: slugify(name), count }));
---

<BaseLayout
  title="Tags"
  description="Explora los posts por etiqueta."
  active="/tags/"
>
  <section class="container max-w-6xl py-8 sm:py-10">
    <h1 class="text-2xl font-semibold tracking-tight text-balance">Tags</h1>
    <p class="mt-1 text-sm text-fg-muted">{tags.length} etiquetas en uso.</p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {tags.map(({ name, slug, count }) => (
        <li>
          <a
            href={`/tags/${slug}/`}
            class="chip"
          >
            #{name}
            <span class="ml-1 text-fg-subtle">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
