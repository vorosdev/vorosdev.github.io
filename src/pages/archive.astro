---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { formatDateShort } from '~/lib/date';
import { getSlug } from '~/lib/slug';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const groups: Record<string, CollectionEntry<'posts'>[]> = {};
for (const post of posts) {
  const year = String(post.data.date.getFullYear());
  (groups[year] ??= []).push(post);
}
const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Archivo"
  description="Listado cronológico de todos los posts."
  active="/archive/"
>
  <section class="container max-w-6xl py-8 sm:py-10">
    <h1 class="text-2xl font-semibold tracking-tight text-balance">Archivo</h1>
    <p class="mt-1 text-sm text-fg-muted">
      {posts.length} {posts.length === 1 ? 'publicación' : 'publicaciones'} en total.
    </p>
    <div class="mt-8 space-y-10">
      {years.map((year) => (
        <div>
          <h2 class="mb-3 font-mono text-sm text-fg-subtle">
            <span class="text-accent">#</span> {year}
          </h2>
          <ul class="surface divide-y divide-border">
            {groups[year].map((post) => (
              <li>
                <a
                  href={`/posts/${getSlug(post.id)}/`}
                  class="flex flex-col gap-1 p-4 transition hover:bg-bg-soft-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
                >
                  <div>
                    <p class="text-base font-medium text-fg">{post.data.title}</p>
                    {post.data.description && (
                      <p class="mt-1 line-clamp-1 text-sm text-fg-muted">{post.data.description}</p>
                    )}
                  </div>
                  <time
                    datetime={post.data.date.toISOString()}
                    class="shrink-0 font-mono text-xs text-fg-subtle"
                  >
                    {formatDateShort(post.data.date)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
