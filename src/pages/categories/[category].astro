---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { slugify } from '~/lib/slug';
import { formatDateShort } from '~/lib/date';
import { getSlug } from '~/lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const catMap = new Map<string, { name: string; posts: typeof posts }>();
  for (const p of posts) {
    for (const cat of p.data.categories) {
      const key = slugify(cat);
      if (!catMap.has(key)) catMap.set(key, { name: cat, posts: [] });
      catMap.get(key)!.posts.push(p);
    }
  }
  return [...catMap.entries()].map(([key, { name, posts }]) => ({
    params: { category: key },
    props: {
      name,
      posts: posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { name, posts } = Astro.props;
---

<BaseLayout
  title={`Categoría: ${name}`}
  description={`Posts en la categoría ${name}.`}
>
  <section class="py-10">
    <p class="font-mono text-xs text-fg-subtle">
      <a class="link" href="/archive/">archivo</a> / <span class="text-accent">{name}</span>
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">{name}</h1>
    <p class="mt-1 text-sm text-fg-muted">
      {posts.length} {posts.length === 1 ? 'publicación' : 'publicaciones'}.
    </p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {posts.map((post) => (
        <li>
          <a
            href={`/posts/${getSlug(post.id)}/`}
            class="surface block p-5 transition hover:border-accent"
          >
            <h2 class="text-base font-semibold text-fg">{post.data.title}</h2>
            <p class="mt-2 line-clamp-2 text-sm text-fg-muted">{post.data.description}</p>
            <p class="mt-3 font-mono text-xs text-fg-subtle">
              <time datetime={post.data.date.toISOString()}>{formatDateShort(post.data.date)}</time>
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
