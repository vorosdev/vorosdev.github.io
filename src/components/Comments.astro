---
import { SITE } from '~/consts';

const repo = import.meta.env.PUBLIC_GISCUS_REPO || SITE.giscus.repo;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || SITE.giscus.repoId;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY || SITE.giscus.category;
const categoryId =
  import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || SITE.giscus.categoryId;

const enabled = Boolean(repo && repoId && category && categoryId);
---

{
  enabled ? (
    <section aria-label="Comentarios" class="not-prose">
      <p class="mb-2 text-xs font-medium uppercase tracking-wider text-fg-subtle">
        Comentarios
      </p>
      <div class="surface p-4">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={repo}
          data-repo-id={repoId}
          data-category={category}
          data-category-id={categoryId}
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="gruvbox-dark"
          data-lang="es"
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
        <noscript>
          Habilita JavaScript para ver los comentarios vía GitHub Discussions.
        </noscript>
      </div>
    </section>
  ) : (
    <section aria-label="Comentarios" class="not-prose">
      <p class="mb-2 text-xs font-medium uppercase tracking-wider text-fg-subtle">
        Comentarios
      </p>
      <div class="surface p-4 text-sm text-fg-muted">
        Los comentarios no están configurados todavía. Configura las variables
        de entorno de giscus para habilitarlos.
      </div>
    </section>
  )
}
