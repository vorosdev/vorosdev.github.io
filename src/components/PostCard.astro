---
import type { CollectionEntry } from 'astro:content';
import { formatDateShort } from '~/lib/date';
import { getSlug } from '~/lib/slug';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<a
  href={`/posts/${getSlug(post.id)}/`}
  class="surface group block h-full p-4 transition hover:border-accent"
>
  <div class="mb-1.5 flex flex-wrap gap-1.5 text-[11px]">
    {post.data.categories.slice(0, 2).map((c) => (
      <span class="chip">{c}</span>
    ))}
  </div>
  <h3 class="text-base font-semibold leading-snug text-fg group-hover:text-accent">
    {post.data.title}
  </h3>
  <p class="mt-1.5 line-clamp-2 text-[13px] leading-relaxed text-fg-muted">
    {post.data.description}
  </p>
  <p class="mt-3 font-mono text-[11px] text-fg-subtle">
    <time datetime={post.data.date.toISOString()}>
      {formatDateShort(post.data.date)}
    </time>
    {post.data.tags.length > 0 && (
      <span> · {post.data.tags.slice(0, 3).map((t) => `#${t}`).join(' ')}</span>
    )}
  </p>
</a>
