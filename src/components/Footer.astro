---
import { SITE } from '~/consts';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 text-sm text-fg-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="font-mono">
      <span class="text-fg-subtle">$</span> echo <span class="text-accent">"© {year} {SITE.author.name}"</span>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href="/rss.xml" class="link" rel="alternate" type="application/rss+xml">RSS</a>
      {
        SITE.author.links.map((link) => (
          <a class="link" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
