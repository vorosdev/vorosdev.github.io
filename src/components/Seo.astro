---
import { SITE } from '~/consts';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultOgImage,
  article = false,
  publishedTime,
  modifiedTime,
  tags = [],
  author = SITE.author.name,
  type = article ? 'article' : 'website',
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="keywords" content={tags.join(', ')} />
<meta name="robots" content={article ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' : 'index, follow'} />
<meta name="theme-color" content="#1d1f21" />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title ?? SITE.name} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title ?? SITE.name} />
<meta property="og:locale" content="es_ES" />
{article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{article && author && <meta property="article:author" content={author} />}
{article && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@_vor_1" />
<meta name="twitter:creator" content="@_vor_1" />
<meta name="twitter:title" content={title ?? SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title ?? SITE.name} />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />

<!-- Preconnect for performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
