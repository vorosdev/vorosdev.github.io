<script is:inline>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const btn = target.closest('[data-theme-toggle]');
    if (!btn) return;
    const element = document.documentElement;
    const isLight = element.dataset.theme === 'gruvbox-light';
    const next = isLight ? 'gruvbox-dark' : 'gruvbox-light';
    element.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<button
  type="button"
  data-theme-toggle
  aria-label="Cambiar tema"
  class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border bg-bg-soft text-fg-muted transition hover:text-accent hover:border-accent"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
</button>
