---
import type { CollectionEntry } from 'astro:content';
import { SITE } from '~/consts';
import { formatDate } from '~/lib/date';
import { slugify } from '~/lib/slug';

export interface Props {
  post: CollectionEntry<'posts'>;
  readingTime: number;
}

const { post, readingTime } = Astro.props;
const { data } = post;
const dateISO = data.date.toISOString();
const archiveHref = SITE.nav[1].href;
---

<header class="not-prose mb-10">
  <nav aria-label="Breadcrumb">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-fg-muted">
      <a class="chip" href={archiveHref}>Blog</a>
      {
        data.categories.map((cat) => (
          <a class="chip chip-accent" href={`/categories/${slugify(cat)}/`}>
            {cat}
          </a>
        ))
      }
    </div>
  </nav>
  <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{data.title}</h1>
  {
    data.description && (
      <p class="mt-3 text-lg text-fg-muted">{data.description}</p>
    )
  }
  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-fg-muted">
    <time datetime={dateISO}>{formatDate(data.date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime} min de lectura</span>
    {
      data.author && (
        <>
          <span aria-hidden="true">·</span>
          <span>por {data.author}</span>
        </>
      )
    }
  </div>
</header>
